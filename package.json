{
  "name": "cognitia",
  "version": "0.2.0",
  "private": true,
  "description": "Cognitia: an academic companion for engineering university students",
  "scripts": {
    "setup": "npm --prefix apps/api ci && npm --prefix apps/web ci && node scripts/ai.mjs setup",
    "dev": "concurrently -n api,web,ai -c blue,magenta,green \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:ai\"",
    "dev:api": "npm --prefix apps/api run dev",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:ai": "node scripts/ai.mjs dev",
    "db:migrate": "npm --prefix apps/api run db:migrate",
    "db:seed": "npm --prefix apps/api run db:seed",
    "db:reset": "npm --prefix apps/api run db:reset",
    "db:studio": "npm --prefix apps/api run db:studio"
  },
  "devDependencies": {
    "concurrently": "10.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
