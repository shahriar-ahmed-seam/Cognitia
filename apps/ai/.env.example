# Copy to .env and fill in. Never commit .env.

# DeepSeek API (https://platform.deepseek.com). Leave empty to use the local heuristic scheduler.
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"

PORT=5000
# Keep 127.0.0.1 unless the service runs on a private network (it has no auth)
HOST=127.0.0.1
