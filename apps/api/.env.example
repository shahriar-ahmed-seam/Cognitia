# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cognitia?schema=public"

# JWT signing secret. Generate one with: openssl rand -hex 32
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

PORT=3001
NODE_ENV=development
# Frontend origin allowed by CORS and used for OAuth redirects
FRONTEND_URL="http://localhost:3000"
# Cognitia AI service
FLASK_API_URL="http://localhost:5000"

# Optional: Redis for multi-instance notifications (falls back to in-memory)
REDIS_URL=""

# Optional: Gmail SMTP for OTP emails. When empty, OTPs are printed to the API console.
EMAIL_USER=""
EMAIL_PASS=""

# Optional: Google OAuth. Google sign-in stays disabled locally without these.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
MAX_FILE_SIZE=10485760
