# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cognitia?schema=public"

# JWT signing secret. Generate one with: openssl rand -hex 32
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

PORT=3001
NODE_ENV=development
# Frontend origin allowed by CORS and used for OAuth redirects
FRONTEND_URL="http://localhost:3000"
# Cognitia AI service
FLASK_API_URL="http://localhost:5000"

# Optional: Redis for multi-instance notifications (falls back to in-memory)
REDIS_URL=""

# Optional: Gmail SMTP for OTP emails. When empty, OTPs are printed to the API console.
EMAIL_USER=""
EMAIL_PASS=""

# Optional: Google OAuth. Google sign-in stays disabled locally without these.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
MAX_FILE_SIZE=10485760
# AI grading of written contest answers
# Encrypts organizers' own AI keys at rest (AES-256-GCM). Generate with: openssl rand -hex 32
# Changing it later makes saved keys unreadable, so organizers would have to add them again.
AI_KEY_ENCRYPTION_SECRET=""
# Cognitia platform AI used when a contest doesn't bring its own key (DeepSeek by default)
AI_PLATFORM_API_KEY=""
AI_PLATFORM_BASE_URL="https://api.deepseek.com"
AI_PLATFORM_MODEL="deepseek-flash"
# Platform AI requests per organizer in any 24 hours
AI_PLATFORM_DAILY_LIMIT=300
# Exam practice: AI-written papers and AI answer checks per student in any 24 hours
AI_PRACTICE_DAILY_PAPERS=8
AI_PRACTICE_DAILY_CHECKS=100
# Community: AI draft answers, thread summaries and event extraction per student per day
AI_COMMUNITY_DAILY=20

# Community uploads (photos, videos, documents) are stored on disk here. Default: apps/api/storage/uploads
# UPLOAD_DIR="/var/lib/cognitia/uploads"
# Signs private media links. Defaults to JWT_SECRET; set its own value to rotate media links separately
# MEDIA_URL_SECRET=""
# Optional: throwaway database for `npm run test:integration` (it is reset on every run)
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cognitia_test?schema=public"
