generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                 @id @default(cuid())
  email                  String                 @unique
  name                   String
  password               String
  role                   UserRole               @default(STUDENT)
  bio                    String?
  institution            String?
  location               String?
  website                String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  otp                    String?
  otpExpires             DateTime?
  verified               Boolean                @default(false)
  grade                  String?
  graduationYear         Int?
  major                  String?
  avatar                 Bytes?
  // Set whenever the avatar changes; also means "has an avatar" without loading the bytes
  avatarUpdatedAt        DateTime?
  // Community profile
  username               String?                @unique
  headline               String?
  // { github?, linkedin?, website?, ... }
  links                  Json?
  skills                 String[]               @default([])
  coverId                String?
  reputation             Int                    @default(0)
  availabilities         Availability[]
  contestsCreated        Contest[]              @relation("ContestCreator")
  contestParticipations  ContestParticipant[]
  contestAnnouncements   ContestAnnouncement[]
  clarificationsAsked    ContestClarification[] @relation("ClarificationAsker")
  clarificationsAnswered ContestClarification[] @relation("ClarificationResponder")
  contestRating          ContestRating?
  contestRatingChanges   ContestRatingChange[]
  contestOrganizerships  ContestOrganizer[]
  gradedContestAnswers   ContestAnswer[]        @relation("ContestAnswerGrader")
  aiCredentials          AiCredential[]
  modelTests             ModelTest[]
  bankQuestions          QuestionBank[]         @relation("BankQuestionAuthor")
  questionReports        QuestionReport[]
  notes                  Note[]
  notesGroups            NotesGroup[]
  notifications          Notification[]
  sessionFeedbacks       SessionFeedback[]
  sessions               StudySession[]
  tasks                  Task[]
  testAttempts           TestAttempt[]
  spacesCreated          Space[]                @relation("SpaceCreator")
  spaceMemberships       SpaceMember[]
  posts                  Post[]                 @relation("PostAuthor")
  replies                Reply[]
  postVotes              PostVote[]
  replyVotes             ReplyVote[]
  savedPosts             SavedPost[]
  pollVotes              PollVote[]
  eventRsvps             EventRsvp[]
  following              Follow[]               @relation("Follower")
  followers              Follow[]               @relation("Following")
  contentReports         ContentReport[]        @relation("Reporter")
  postViews              PostView[]
  interests              UserInterest[]
  mediaFiles             MediaFile[]
  aiFeedback             PostAiFeedback[]

  @@map("users")
}

model NotesGroup {
  id          String   @id @default(cuid())
  name        String
  description String?
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
  notes       Note[]
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notes_groups")
}

model Note {
  id           String     @id @default(cuid())
  title        String
  visibility   Visibility @default(PRIVATE)
  authorId     String
  notesGroupId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now())
  tags         String[]   @default([])
  file         Bytes
  author       User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  notesGroup   NotesGroup @relation(fields: [notesGroupId], references: [id], onDelete: Cascade)

  @@map("notes")
}

model Task {
  id            String         @id @default(cuid())
  title         String
  description   String?
  dueDate       DateTime
  status        TaskStatus     @default(NOT_STARTED)
  priority      Priority       @default(MEDIUM)
  subjectArea   String
  estimatedTime Int?
  completedAt   DateTime?
  userId        String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now())
  tags          String[]       @default([])
  file          Bytes?
  // Set for tasks added from a community event ("Add to my plan")
  sourcePostId  String?
  sourcePost    Post?          @relation(fields: [sourcePostId], references: [id], onDelete: SetNull)
  sessions      StudySession[]
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tasks")
}

model StudySession {
  id              String           @id @default(cuid())
  startTime       DateTime
  endTime         DateTime
  goal            String?
  completed       Boolean          @default(false)
  userId          String
  taskId          String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now())
  notes           String?
  sessionFeedback SessionFeedback?
  task            Task?            @relation(fields: [taskId], references: [id])
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("study_sessions")
}

model Availability {
  id        String   @id @default(cuid())
  startTime DateTime
  endTime   DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("availabilities")
}

model SessionFeedback {
  id              String       @id @default(cuid())
  userId          String
  sessionId       String       @unique
  confidenceScore Int
  feedbackAt      DateTime
  studysession    StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session_feedback")
}

// A practice paper (class test, term final mock, drill...). Owned by one student; can be
// shared by link so classmates take it privately.
model ModelTest {
  id           String     @id @default(cuid())
  title        String
  description  String
  // Minutes; 0 = untimed
  timeLimit    Int
  subjects     String[]   @default([])
  topics       String[]   @default([])
  difficulty   Difficulty @default(MEDIUM)
  // Legacy, unused since v2
  isCustom     Boolean    @default(false)
  passingScore Int
  // Highest possible score (sections with "answer any N" count their best N)
  totalPoints  Int

  format           PracticeFormat  @default(CUSTOM)
  mode             PracticeMode    @default(EXAM)
  source           PaperSource     @default(BANK)
  status           PaperStatus     @default(READY)
  // Why generation failed, or a note such as "Made 13 of 15 questions"
  statusNote       String?
  visibility       PaperVisibility @default(PRIVATE)
  negativeMarking  Float           @default(0)
  shuffleQuestions Boolean         @default(true)
  shuffleOptions   Boolean         @default(true)
  // [{ name, answerAny? }] in paper order; questions refer to them by name
  sections         Json?
  instructions     String          @default("")
  // What the paper was built from (topics, mix, notes excerpt), for "make another like this"
  spec             Json?

  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  userId      String
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments QuestionAssignment[]
  attempts    TestAttempt[]

  @@index([userId, createdAt])
  @@map("model_tests")
}

model TestAttempt {
  id             String        @id @default(cuid())
  status         AttemptStatus @default(IN_PROGRESS)
  startTime      DateTime      @default(now())
  endTime        DateTime?
  // Seconds from start to submission, measured by the server
  timeSpent      Int?
  score          Float?
  correctAnswers Int?
  totalQuestions Int
  // Legacy answer map (v1); v2 answers live in test_answers
  answers        Json          @default("{}")
  userId         String
  testId         String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now())
  autoSubmitted  Boolean       @default(false)
  lastActivity   DateTime?

  // Null when untimed
  deadlineAt    DateTime?
  // Per-attempt seed for question and option order
  seed          Int       @default(0)
  maxScore      Float     @default(0)
  partialCount  Int       @default(0)
  wrongCount    Int       @default(0)
  answeredCount Int       @default(0)
  // Written answers still waiting for a grade
  pendingCount  Int       @default(0)

  test        ModelTest       @relation(fields: [testId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  testAnswers TestAnswer[]
  files       PracticeAsset[]

  @@index([userId, status])
  @@index([testId])
  @@map("test_attempts")
}

// One answer in a practice attempt. Mirrors contest answers, including AI grading.
model TestAnswer {
  id         String        @id @default(cuid())
  attemptId  String
  questionId String
  response   Json?
  flagged    Boolean       @default(false)
  verdict    AnswerVerdict @default(UNANSWERED)
  score      Float         @default(0)
  answeredAt DateTime      @default(now())
  // Practice mode: when the student checked this answer (it's locked afterwards)
  checkedAt  DateTime?

  gradingStatus GradingStatus @default(NONE)
  feedback      String?
  gradeSource   GradeSource?
  gradedAt      DateTime?
  aiScore       Float?
  aiFeedback    String?
  aiConfidence  Float?
  aiBreakdown   Json?
  aiFlags       String[]      @default([])
  aiModel       String?
  aiGradedAt    DateTime?
  aiError       String?
  aiAttempts    Int           @default(0)
  aiClaimedAt   DateTime?
  // Student-requested AI re-checks
  recheckCount  Int           @default(0)

  attempt  TestAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question QuestionBank @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([gradingStatus])
  @@index([questionId])
  @@map("test_answers")
}

// Photos of handwritten work in a practice attempt; private to the student
model PracticeAsset {
  id         String   @id @default(cuid())
  attemptId  String
  questionId String
  mimeType   String
  size       Int
  data       Bytes
  createdAt  DateTime @default(now())

  attempt TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId, questionId])
  @@map("practice_assets")
}

// "This question is wrong" reports from students
model QuestionReport {
  id         String   @id @default(cuid())
  questionId String
  userId     String
  reason     String
  createdAt  DateTime @default(now())

  question QuestionBank @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([questionId, userId])
  @@map("question_reports")
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  message   String
  // Optional in-app path the notification opens, e.g. /contests/abc/results
  link      String?
  isRead    Boolean          @default(false)
  userId    String
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

// Shared question bank: curated questions, plus AI-written and personal ones (private to their author)
model QuestionBank {
  id            String               @id @default(cuid())
  type          ContestQuestionType  @default(SINGLE_CHOICE)
  question      String
  explanation   String?
  // Choice types: string[] of option texts
  options       Json?
  // SINGLE_CHOICE only (legacy); `answer` holds the key for every type
  correctAnswer Int?
  // Answer key in the contest engine's shape (see modules/contests/engine.js)
  answer        Json?
  // Marks; null = by difficulty
  points        Int?
  subject       String
  topics        String[]             @default([])
  difficulty    Difficulty           @default(MEDIUM)
  source        QuestionSource       @default(CURATED)
  createdById   String?
  isPublic      Boolean              @default(true)
  reportCount   Int                  @default(0)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @default(now())
  createdBy     User?                @relation("BankQuestionAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  assignments   QuestionAssignment[]
  testAnswers   TestAnswer[]
  reports       QuestionReport[]

  @@index([subject])
  @@index([createdById])
  @@map("question_banks")
}

// Links a bank question to a model test
model QuestionAssignment {
  id          String       @id @default(cuid())
  questionId  String
  modelTestId String?
  points      Int          @default(5)
  // Position in the paper, and the section it belongs to
  order       Int          @default(0)
  section     String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  modelTest   ModelTest?   @relation(fields: [modelTestId], references: [id], onDelete: Cascade)
  question    QuestionBank @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("question_assignments")
}

// ---------------------------------------------------------------------------
// Contests
// The contest phase (draft, upcoming, live, ended, results, cancelled) is always
// computed from the timestamps below, never stored.
// ---------------------------------------------------------------------------

model Contest {
  id          String      @id @default(cuid())
  title       String
  summary     String
  description String      @default("")
  rules       String      @default("")
  kind        ContestKind @default(QUIZ)
  difficulty  Difficulty  @default(MEDIUM)
  subjects    String[]    @default([])
  topics      String[]    @default([])
  hostName    String?

  timing               ContestTiming @default(FIXED)
  startsAt             DateTime
  endsAt               DateTime
  // FIXED: length of the window. FLEXIBLE: personal time limit once started.
  durationMinutes      Int
  registrationClosesAt DateTime?

  visibility  ContestVisibility @default(PUBLIC)
  institution String?
  accessCode  String?
  capacity    Int?

  // Fraction of a question's points deducted for a wrong answer (0.25 = quarter mark)
  negativeMarking  Float              @default(0)
  shuffleQuestions Boolean            @default(true)
  shuffleOptions   Boolean            @default(true)
  liveStandings    Boolean            @default(true)
  resultsMode      ContestResultsMode @default(AUTO)
  isRated          Boolean            @default(false)

  // How WRITTEN answers are graded
  writtenGrading WrittenGradingMode @default(MANUAL)
  aiSource       AiSource           @default(PLATFORM)
  aiCredentialId String?
  // Extra guidance for the AI grader, e.g. "accept either unit"
  aiInstructions String             @default("")
  // Hide participant names from graders
  blindGrading   Boolean            @default(true)

  publishedAt        DateTime?
  cancelledAt        DateTime?
  cancelReason       String?
  reminderSentAt     DateTime?
  startNoticeSentAt  DateTime?
  finalizedAt        DateTime?
  resultsPublishedAt DateTime?
  ratingsAppliedAt   DateTime?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy      User?                  @relation("ContestCreator", fields: [createdById], references: [id], onDelete: SetNull)
  aiCredential   AiCredential?          @relation(fields: [aiCredentialId], references: [id], onDelete: SetNull)
  questions      ContestQuestion[]
  participants   ContestParticipant[]
  announcements  ContestAnnouncement[]
  clarifications ContestClarification[]
  ratingChanges  ContestRatingChange[]
  organizers     ContestOrganizer[]
  assets         ContestAsset[]

  @@index([startsAt])
  @@index([endsAt])
  @@map("contests")
}

// A contest's own copy of each question, so later question-bank edits never
// change a contest that already ran.
model ContestQuestion {
  id               String              @id @default(cuid())
  contestId        String
  order            Int
  type             ContestQuestionType
  prompt           String
  // Choice types: string[] of option texts
  options          Json?
  // Answer key, shape depends on type (see modules/contests/engine.js)
  answer           Json
  explanation      String?
  points           Int                 @default(1)
  partialCredit    Boolean             @default(false)
  subject          String?
  topics           String[]            @default([])
  difficulty       Difficulty          @default(MEDIUM)
  // Optional part heading, e.g. "Part A: MCQ". Shuffling stays within a section.
  section          String?
  sourceQuestionId String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  contest        Contest                @relation(fields: [contestId], references: [id], onDelete: Cascade)
  answers        ContestAnswer[]
  clarifications ContestClarification[]

  @@index([contestId, order])
  @@map("contest_questions")
}

// Registration and attempt in one row
model ContestParticipant {
  id            String                   @id @default(cuid())
  contestId     String
  userId        String
  status        ContestParticipantStatus @default(REGISTERED)
  registeredAt  DateTime                 @default(now())
  startedAt     DateTime?
  deadlineAt    DateTime?
  submittedAt   DateTime?
  autoSubmitted Boolean                  @default(false)
  // Per-participant seed for question and option order
  seed          Int                      @default(0)

  score         Float     @default(0)
  correctCount  Int       @default(0)
  partialCount  Int       @default(0)
  wrongCount    Int       @default(0)
  answeredCount Int       @default(0)
  // Written answers that still need a grade
  pendingCount  Int       @default(0)
  lastAnswerAt  DateTime?
  // Tie-breaker: seconds from start to the last saved answer
  timeTakenSec  Int?
  rank          Int?

  focusLossCount   Int       @default(0)
  disqualifiedAt   DateTime?
  disqualifyReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contest Contest         @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers ContestAnswer[]
  files   ContestAsset[]

  @@unique([contestId, userId])
  @@index([contestId, status])
  @@index([userId])
  @@map("contest_participants")
}

model ContestAnswer {
  id            String        @id @default(cuid())
  participantId String
  questionId    String
  // null when the question is only flagged for review
  response      Json?
  flagged       Boolean       @default(false)
  verdict       AnswerVerdict @default(UNANSWERED)
  score         Float         @default(0)
  answeredAt    DateTime      @default(now())

  // Written answers only
  gradingStatus GradingStatus @default(NONE)
  // Final feedback shown to the student
  feedback      String?
  gradeSource   GradeSource?
  gradedById    String?
  gradedAt      DateTime?
  aiScore       Float?
  aiFeedback    String?
  aiConfidence  Float?
  // [{ criterion, awarded, max, comment }]
  aiBreakdown   Json?
  aiFlags       String[]      @default([])
  aiModel       String?
  aiGradedAt    DateTime?
  aiError       String?
  aiAttempts    Int           @default(0)
  aiClaimedAt   DateTime?

  participant ContestParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  question    ContestQuestion    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  gradedBy    User?              @relation("ContestAnswerGrader", fields: [gradedById], references: [id], onDelete: SetNull)

  @@unique([participantId, questionId])
  @@index([questionId])
  @@index([gradingStatus])
  @@map("contest_answers")
}

// Organizing team for a contest. The creator is the OWNER.
model ContestOrganizer {
  contestId String
  userId    String
  role      ContestOrganizerRole @default(EDITOR)
  addedById String?
  createdAt DateTime             @default(now())

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([contestId, userId])
  @@index([userId])
  @@map("contest_organizers")
}

// Uploaded images. QUESTION assets are served by id without auth (ids are unguessable);
// ANSWER assets (handwritten work) are only served to their author and the organizers.
model ContestAsset {
  id            String           @id @default(cuid())
  contestId     String
  kind          ContestAssetKind
  uploaderId    String?
  participantId String?
  questionId    String?
  mimeType      String
  size          Int
  data          Bytes
  createdAt     DateTime         @default(now())

  contest     Contest             @relation(fields: [contestId], references: [id], onDelete: Cascade)
  participant ContestParticipant? @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([contestId])
  @@index([participantId, questionId])
  @@map("contest_assets")
}

// An organizer's own AI provider key, encrypted at rest (AES-256-GCM)
model AiCredential {
  id            String     @id @default(cuid())
  ownerId       String
  label         String
  provider      AiProvider
  baseUrl       String
  model         String
  keyCiphertext String
  keyLast4      String
  lastUsedAt    DateTime?
  lastTestedAt  DateTime?
  lastTestOk    Boolean?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  owner    User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  contests Contest[]

  @@index([ownerId])
  @@map("ai_credentials")
}

// One row per AI request, for quotas and cost tracking
model AiUsage {
  id               String   @id @default(cuid())
  // Who the request counts against (the contest owner for platform AI)
  userId           String?
  contestId        String?
  // null = Cognitia platform AI
  credentialId     String?
  purpose          String
  model            String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  success          Boolean
  error            String?
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
  @@index([contestId])
  @@map("ai_usage")
}

model ContestAnnouncement {
  id        String   @id @default(cuid())
  contestId String
  authorId  String?
  title     String
  body      String
  createdAt DateTime @default(now())

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  author  User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([contestId, createdAt])
  @@map("contest_announcements")
}

model ContestClarification {
  id           String    @id @default(cuid())
  contestId    String
  questionId   String?
  askedById    String
  question     String
  answer       String?
  answeredById String?
  answeredAt   DateTime?
  // Public answers are shown to every participant
  isPublic     Boolean   @default(false)
  createdAt    DateTime  @default(now())

  contest         Contest          @relation(fields: [contestId], references: [id], onDelete: Cascade)
  contestQuestion ContestQuestion? @relation(fields: [questionId], references: [id], onDelete: SetNull)
  askedBy         User             @relation("ClarificationAsker", fields: [askedById], references: [id], onDelete: Cascade)
  answeredBy      User?            @relation("ClarificationResponder", fields: [answeredById], references: [id], onDelete: SetNull)

  @@index([contestId, createdAt])
  @@map("contest_clarifications")
}

// Current contest rating per user
model ContestRating {
  userId        String   @id
  rating        Int      @default(1500)
  peakRating    Int      @default(1500)
  contestsRated Int      @default(0)
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([rating])
  @@map("contest_ratings")
}

model ContestRatingChange {
  id           String   @id @default(cuid())
  contestId    String
  userId       String
  rank         Int
  participants Int
  oldRating    Int
  newRating    Int
  delta        Int
  createdAt    DateTime @default(now())

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contestId, userId])
  @@index([userId, createdAt])
  @@map("contest_rating_changes")
}

enum UserRole {
  STUDENT
  // Teachers, CRs and club leads who can host contests
  ORGANIZER
  ADMIN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
  EXPERT
}

enum Visibility {
  PRIVATE
  PUBLIC
  SHARED
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum ContestKind {
  QUIZ
  CHALLENGE
  MOCK_EXAM
  OLYMPIAD
  APTITUDE
}

enum ContestTiming {
  FIXED
  FLEXIBLE
}

enum ContestVisibility {
  PUBLIC
  INSTITUTION
  PRIVATE
}

enum ContestResultsMode {
  AUTO
  MANUAL
}

enum ContestQuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
  NUMERIC
  SHORT_TEXT
  // Typed and/or handwritten (photo) answer, graded by organizers or AI
  WRITTEN
}

enum ContestOrganizerRole {
  OWNER
  EDITOR
  GRADER
}

enum ContestAssetKind {
  QUESTION
  ANSWER
}

enum WrittenGradingMode {
  // Organizers grade every written answer
  MANUAL
  // AI suggests a grade; an organizer approves each one
  AI_ASSISTED
  // AI grades; low-confidence or flagged answers go to organizers
  AI_AUTO
}

enum AiSource {
  PLATFORM
  OWN_KEY
}

enum AiProvider {
  DEEPSEEK
  OPENAI
  OPENAI_COMPATIBLE
}

enum GradingStatus {
  // Objective question, or written answer not submitted yet
  NONE
  QUEUED
  RUNNING
  NEEDS_REVIEW
  GRADED
}

enum GradeSource {
  AI
  ORGANIZER
  // Practice: the student marked it against the rubric
  SELF
}

enum PracticeFormat {
  CLASS_TEST
  TERM_FINAL
  TOPIC_DRILL
  MISTAKES
  CUSTOM
}

enum PracticeMode {
  // Answers and marks after submitting
  EXAM
  // Check each answer as you go
  PRACTICE
}

enum PaperSource {
  BANK
  AI
  MISTAKES
}

enum PaperStatus {
  GENERATING
  READY
  FAILED
}

enum PaperVisibility {
  PRIVATE
  // Anyone with the link can take it
  LINK
}

enum QuestionSource {
  CURATED
  AI
  USER
}

enum ContestParticipantStatus {
  REGISTERED
  IN_PROGRESS
  SUBMITTED
}

enum AnswerVerdict {
  CORRECT
  PARTIAL
  WRONG
  UNANSWERED
  // Written answer waiting for a grade
  PENDING
}

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
}

enum NotificationType {
  NOTE_UPLOADED
  TASK_OVERDUE
  TASK_STARTED
  TASK_COMPLETED
  TASK_ADDED
  SESSION_STARTED
  SESSION_ADDED
  TASK_DEADLINE_SOON
  CONTEST_REGISTERED
  CONTEST_UNREGISTERED
  CONTEST_REMINDER
  CONTEST_STARTED
  CONTEST_ENDED
  CONTEST_RANKING
  CONTEST_ANNOUNCEMENT
  CONTEST_CLARIFICATION
  CONTEST_CANCELLED
  CONTEST_TEAM
  QUESTION_UPVOTED
  ANSWER_UPVOTED
  QUESTION_POSTED
  QUESTION_REPLIED
  LOGIN
  PASSWORD_CHANGED
  COMMUNITY_REPLY
  COMMUNITY_ANSWER
  COMMUNITY_ACCEPTED
  COMMUNITY_MENTION
  COMMUNITY_FOLLOW
  COMMUNITY_SPACE
  COMMUNITY_POST
