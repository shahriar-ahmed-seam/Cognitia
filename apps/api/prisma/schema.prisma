generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                 @id @default(cuid())
  email                  String                 @unique
  name                   String
  password               String
  role                   UserRole               @default(STUDENT)
  bio                    String?
  institution            String?
  location               String?
  website                String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  otp                    String?
  otpExpires             DateTime?
  verified               Boolean                @default(false)
  grade                  String?
  graduationYear         Int?
  major                  String?
  avatar                 Bytes?
  answerVotes            AnswerVote[]
  answers                Answer[]
  availabilities         Availability[]
  contestsCreated        Contest[]              @relation("ContestCreator")
  contestParticipations  ContestParticipant[]
  contestAnnouncements   ContestAnnouncement[]
  clarificationsAsked    ContestClarification[] @relation("ClarificationAsker")
  clarificationsAnswered ContestClarification[] @relation("ClarificationResponder")
  contestRating          ContestRating?
  contestRatingChanges   ContestRatingChange[]
  contestOrganizerships  ContestOrganizer[]
  gradedContestAnswers   ContestAnswer[]        @relation("ContestAnswerGrader")
  aiCredentials          AiCredential[]
  modelTests             ModelTest[]
  notes                  Note[]
  notesGroups            NotesGroup[]
  notifications          Notification[]
  questionVotes          QuestionVote[]
  questions              Question[]
  sessionFeedbacks       SessionFeedback[]
  sessions               StudySession[]
  tasks                  Task[]
  testAttempts           TestAttempt[]

  @@map("users")
}

model Question {
  id        String         @id @default(cuid())
  title     String
  body      String
  tags      String[]
  views     Int            @default(0)
  subject   String?
  authorId  String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  answers   Answer[]
  votes     QuestionVote[]
  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("questions")
}

model Answer {
  id         String       @id @default(cuid())
  content    String
  questionId String
  authorId   String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @default(now())
  votes      AnswerVote[]
  author     User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  question   Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("answers")
}

model QuestionVote {
  id         String   @id @default(cuid())
  voteType   VoteType
  questionId String
  userId     String
  createdAt  DateTime @default(now())
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([questionId, userId])
  @@map("question_votes")
}

model AnswerVote {
  id        String   @id @default(cuid())
  voteType  VoteType
  answerId  String
  userId    String
  createdAt DateTime @default(now())
  answer    Answer   @relation(fields: [answerId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([answerId, userId])
  @@map("answer_votes")
}

model NotesGroup {
  id          String   @id @default(cuid())
  name        String
  description String?
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
  notes       Note[]
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notes_groups")
}

model Note {
  id           String     @id @default(cuid())
  title        String
  visibility   Visibility @default(PRIVATE)
  authorId     String
  notesGroupId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now())
  tags         String[]   @default([])
  file         Bytes
  author       User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  notesGroup   NotesGroup @relation(fields: [notesGroupId], references: [id], onDelete: Cascade)

  @@map("notes")
}

model Task {
  id            String         @id @default(cuid())
  title         String
  description   String?
  dueDate       DateTime
  status        TaskStatus     @default(NOT_STARTED)
  priority      Priority       @default(MEDIUM)
  subjectArea   String
  estimatedTime Int?
  completedAt   DateTime?
  userId        String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now())
  tags          String[]       @default([])
  file          Bytes?
  sessions      StudySession[]
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tasks")
}

model StudySession {
  id              String           @id @default(cuid())
  startTime       DateTime
  endTime         DateTime
  goal            String?
  completed       Boolean          @default(false)
  userId          String
  taskId          String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now())
  notes           String?
  sessionFeedback SessionFeedback?
  task            Task?            @relation(fields: [taskId], references: [id])
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("study_sessions")
}

model Availability {
  id        String   @id @default(cuid())
  startTime DateTime
  endTime   DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("availabilities")
}

model SessionFeedback {
  id              String       @id @default(cuid())
  userId          String
  sessionId       String       @unique
  confidenceScore Int
  feedbackAt      DateTime
  studysession    StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session_feedback")
}

model ModelTest {
  id           String               @id @default(cuid())
  title        String
  description  String
  timeLimit    Int
  subjects     String[]             @default([])
  topics       String[]             @default([])
  difficulty   Difficulty           @default(MEDIUM)
  isCustom     Boolean              @default(false)
  passingScore Int
  totalPoints  Int
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  userId       String
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments  QuestionAssignment[]
  attempts     TestAttempt[]

  @@map("model_tests")
}

model TestAttempt {
  id             String        @id @default(cuid())
  status         AttemptStatus @default(IN_PROGRESS)
  startTime      DateTime      @default(now())
  endTime        DateTime?
  timeSpent      Int?
  score          Int?
  correctAnswers Int?
  totalQuestions Int
  answers        Json          @default("{}")
  userId         String
  testId         String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now())
  autoSubmitted  Boolean       @default(false)
  lastActivity   DateTime?
  test           ModelTest     @relation(fields: [testId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("test_attempts")
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  message   String
  // Optional in-app path the notification opens, e.g. /contests/abc/results
  link      String?
  isRead    Boolean          @default(false)
  userId    String
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

model QuestionBank {
  id            String               @id @default(cuid())
  question      String
  explanation   String?
  options       Json
  correctAnswer Int
  subject       String
  topics        String[]             @default([])
  difficulty    Difficulty           @default(MEDIUM)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @default(now())
  assignments   QuestionAssignment[]

  @@map("question_banks")
}

// Links a bank question to a model test
model QuestionAssignment {
  id          String       @id @default(cuid())
  questionId  String
  modelTestId String?
  points      Int          @default(5)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  modelTest   ModelTest?   @relation(fields: [modelTestId], references: [id], onDelete: Cascade)
  question    QuestionBank @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("question_assignments")
}

// ---------------------------------------------------------------------------
// Contests
// The contest phase (draft, upcoming, live, ended, results, cancelled) is always
// computed from the timestamps below, never stored.
// ---------------------------------------------------------------------------

model Contest {
  id          String      @id @default(cuid())
  title       String
  summary     String
  description String      @default("")
  rules       String      @default("")
  kind        ContestKind @default(QUIZ)
  difficulty  Difficulty  @default(MEDIUM)
  subjects    String[]    @default([])
  topics      String[]    @default([])
  hostName    String?

  timing               ContestTiming @default(FIXED)
  startsAt             DateTime
  endsAt               DateTime
  // FIXED: length of the window. FLEXIBLE: personal time limit once started.
  durationMinutes      Int
  registrationClosesAt DateTime?

  visibility  ContestVisibility @default(PUBLIC)
  institution String?
  accessCode  String?
  capacity    Int?

  // Fraction of a question's points deducted for a wrong answer (0.25 = quarter mark)
  negativeMarking  Float              @default(0)
  shuffleQuestions Boolean            @default(true)
  shuffleOptions   Boolean            @default(true)
  liveStandings    Boolean            @default(true)
  resultsMode      ContestResultsMode @default(AUTO)
  isRated          Boolean            @default(false)

  // How WRITTEN answers are graded
  writtenGrading WrittenGradingMode @default(MANUAL)
  aiSource       AiSource           @default(PLATFORM)
  aiCredentialId String?
  // Extra guidance for the AI grader, e.g. "accept either unit"
  aiInstructions String             @default("")
  // Hide participant names from graders
  blindGrading   Boolean            @default(true)

  publishedAt        DateTime?
  cancelledAt        DateTime?
  cancelReason       String?
  reminderSentAt     DateTime?
  startNoticeSentAt  DateTime?
  finalizedAt        DateTime?
  resultsPublishedAt DateTime?
  ratingsAppliedAt   DateTime?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy      User?                  @relation("ContestCreator", fields: [createdById], references: [id], onDelete: SetNull)
  aiCredential   AiCredential?          @relation(fields: [aiCredentialId], references: [id], onDelete: SetNull)
  questions      ContestQuestion[]
  participants   ContestParticipant[]
  announcements  ContestAnnouncement[]
  clarifications ContestClarification[]
  ratingChanges  ContestRatingChange[]
  organizers     ContestOrganizer[]
  assets         ContestAsset[]

  @@index([startsAt])
  @@index([endsAt])
  @@map("contests")
}

// A contest's own copy of each question, so later question-bank edits never
// change a contest that already ran.
model ContestQuestion {
  id               String              @id @default(cuid())
  contestId        String
  order            Int
  type             ContestQuestionType
  prompt           String
  // Choice types: string[] of option texts
  options          Json?
  // Answer key, shape depends on type (see modules/contests/engine.js)
  answer           Json
  explanation      String?
  points           Int                 @default(1)
  partialCredit    Boolean             @default(false)
  subject          String?
  topics           String[]            @default([])
  difficulty       Difficulty          @default(MEDIUM)
  // Optional part heading, e.g. "Part A: MCQ". Shuffling stays within a section.
  section          String?
  sourceQuestionId String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  contest        Contest                @relation(fields: [contestId], references: [id], onDelete: Cascade)
  answers        ContestAnswer[]
  clarifications ContestClarification[]

  @@index([contestId, order])
  @@map("contest_questions")
}

// Registration and attempt in one row
model ContestParticipant {
  id            String                   @id @default(cuid())
  contestId     String
  userId        String
  status        ContestParticipantStatus @default(REGISTERED)
  registeredAt  DateTime                 @default(now())
  startedAt     DateTime?
  deadlineAt    DateTime?
  submittedAt   DateTime?
  autoSubmitted Boolean                  @default(false)
  // Per-participant seed for question and option order
  seed          Int                      @default(0)

  score         Float     @default(0)
  correctCount  Int       @default(0)
  partialCount  Int       @default(0)
  wrongCount    Int       @default(0)
  answeredCount Int       @default(0)
  // Written answers that still need a grade
  pendingCount  Int       @default(0)
  lastAnswerAt  DateTime?
  // Tie-breaker: seconds from start to the last saved answer
  timeTakenSec  Int?
  rank          Int?

  focusLossCount   Int       @default(0)
  disqualifiedAt   DateTime?
  disqualifyReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contest Contest         @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers ContestAnswer[]
  files   ContestAsset[]

  @@unique([contestId, userId])
  @@index([contestId, status])
  @@index([userId])
  @@map("contest_participants")
}

model ContestAnswer {
  id            String        @id @default(cuid())
  participantId String
  questionId    String
  // null when the question is only flagged for review
  response      Json?
  flagged       Boolean       @default(false)
  verdict       AnswerVerdict @default(UNANSWERED)
  score         Float         @default(0)
  answeredAt    DateTime      @default(now())

  // Written answers only
  gradingStatus GradingStatus @default(NONE)
  // Final feedback shown to the student
  feedback      String?
  gradeSource   GradeSource?
  gradedById    String?
  gradedAt      DateTime?
  aiScore       Float?
  aiFeedback    String?
  aiConfidence  Float?
  // [{ criterion, awarded, max, comment }]
  aiBreakdown   Json?
  aiFlags       String[]      @default([])
  aiModel       String?
  aiGradedAt    DateTime?
  aiError       String?
  aiAttempts    Int           @default(0)
  aiClaimedAt   DateTime?

  participant ContestParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  question    ContestQuestion    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  gradedBy    User?              @relation("ContestAnswerGrader", fields: [gradedById], references: [id], onDelete: SetNull)

  @@unique([participantId, questionId])
  @@index([questionId])
  @@index([gradingStatus])
  @@map("contest_answers")
}

// Organizing team for a contest. The creator is the OWNER.
model ContestOrganizer {
  contestId String
  userId    String
  role      ContestOrganizerRole @default(EDITOR)
  addedById String?
  createdAt DateTime             @default(now())

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([contestId, userId])
  @@index([userId])
  @@map("contest_organizers")
}

// Uploaded images. QUESTION assets are served by id without auth (ids are unguessable);
// ANSWER assets (handwritten work) are only served to their author and the organizers.
model ContestAsset {
  id            String           @id @default(cuid())
  contestId     String
  kind          ContestAssetKind
  uploaderId    String?
  participantId String?
  questionId    String?
  mimeType      String
  size          Int
  data          Bytes
  createdAt     DateTime         @default(now())

  contest     Contest             @relation(fields: [contestId], references: [id], onDelete: Cascade)
  participant ContestParticipant? @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([contestId])
  @@index([participantId, questionId])
  @@map("contest_assets")
}

// An organizer's own AI provider key, encrypted at rest (AES-256-GCM)
model AiCredential {
  id            String     @id @default(cuid())
  ownerId       String
  label         String
  provider      AiProvider
  baseUrl       String
  model         String
  keyCiphertext String
  keyLast4      String
  lastUsedAt    DateTime?
  lastTestedAt  DateTime?
  lastTestOk    Boolean?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  owner    User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  contests Contest[]

  @@index([ownerId])
  @@map("ai_credentials")
}

// One row per AI request, for quotas and cost tracking
model AiUsage {
  id               String   @id @default(cuid())
  // Who the request counts against (the contest owner for platform AI)
  userId           String?
  contestId        String?
  // null = Cognitia platform AI
  credentialId     String?
  purpose          String
  model            String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  success          Boolean
  error            String?
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
  @@index([contestId])
  @@map("ai_usage")
}

model ContestAnnouncement {
  id        String   @id @default(cuid())
  contestId String
  authorId  String?
  title     String
  body      String
  createdAt DateTime @default(now())

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  author  User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([contestId, createdAt])
  @@map("contest_announcements")
}

model ContestClarification {
  id           String    @id @default(cuid())
  contestId    String
  questionId   String?
  askedById    String
  question     String
  answer       String?
  answeredById String?
  answeredAt   DateTime?
  // Public answers are shown to every participant
  isPublic     Boolean   @default(false)
  createdAt    DateTime  @default(now())

  contest         Contest          @relation(fields: [contestId], references: [id], onDelete: Cascade)
  contestQuestion ContestQuestion? @relation(fields: [questionId], references: [id], onDelete: SetNull)
  askedBy         User             @relation("ClarificationAsker", fields: [askedById], references: [id], onDelete: Cascade)
  answeredBy      User?            @relation("ClarificationResponder", fields: [answeredById], references: [id], onDelete: SetNull)

  @@index([contestId, createdAt])
  @@map("contest_clarifications")
}

// Current contest rating per user
model ContestRating {
  userId        String   @id
  rating        Int      @default(1500)
  peakRating    Int      @default(1500)
  contestsRated Int      @default(0)
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([rating])
  @@map("contest_ratings")
}

model ContestRatingChange {
  id           String   @id @default(cuid())
  contestId    String
  userId       String
  rank         Int
  participants Int
  oldRating    Int
  newRating    Int
  delta        Int
  createdAt    DateTime @default(now())

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contestId, userId])
  @@index([userId, createdAt])
  @@map("contest_rating_changes")
}

enum UserRole {
  STUDENT
  // Teachers, CRs and club leads who can host contests
  ORGANIZER
  ADMIN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
  EXPERT
}

enum VoteType {
  UP
  DOWN
}

enum Visibility {
  PRIVATE
  PUBLIC
  SHARED
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum ContestKind {
  QUIZ
  CHALLENGE
  MOCK_EXAM
  OLYMPIAD
  APTITUDE
}

enum ContestTiming {
  FIXED
  FLEXIBLE
}

enum ContestVisibility {
  PUBLIC
  INSTITUTION
  PRIVATE
}

enum ContestResultsMode {
  AUTO
  MANUAL
}

enum ContestQuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
  NUMERIC
  SHORT_TEXT
  // Typed and/or handwritten (photo) answer, graded by organizers or AI
  WRITTEN
}

enum ContestOrganizerRole {
  OWNER
  EDITOR
  GRADER
}

enum ContestAssetKind {
  QUESTION
  ANSWER
}

enum WrittenGradingMode {
  // Organizers grade every written answer
  MANUAL
  // AI suggests a grade; an organizer approves each one
  AI_ASSISTED
  // AI grades; low-confidence or flagged answers go to organizers
  AI_AUTO
}

enum AiSource {
  PLATFORM
  OWN_KEY
}

enum AiProvider {
  DEEPSEEK
  OPENAI
  OPENAI_COMPATIBLE
}

enum GradingStatus {
  // Objective question, or written answer not submitted yet
  NONE
  QUEUED
  RUNNING
  NEEDS_REVIEW
  GRADED
}

enum GradeSource {
  AI
  ORGANIZER
}

enum ContestParticipantStatus {
  REGISTERED
  IN_PROGRESS
  SUBMITTED
}

enum AnswerVerdict {
  CORRECT
  PARTIAL
  WRONG
  UNANSWERED
  // Written answer waiting for a grade
  PENDING
}

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
}

enum NotificationType {
  NOTE_UPLOADED
  TASK_OVERDUE
  TASK_STARTED
  TASK_COMPLETED
  TASK_ADDED
  SESSION_STARTED
  SESSION_ADDED
  TASK_DEADLINE_SOON
  CONTEST_REGISTERED
  CONTEST_UNREGISTERED
  CONTEST_REMINDER
  CONTEST_STARTED
  CONTEST_ENDED
  CONTEST_RANKING
  CONTEST_ANNOUNCEMENT
  CONTEST_CLARIFICATION
  CONTEST_CANCELLED
  CONTEST_TEAM
  QUESTION_UPVOTED
  ANSWER_UPVOTED
  QUESTION_POSTED
  QUESTION_REPLIED
  LOGIN
  PASSWORD_CHANGED
}
